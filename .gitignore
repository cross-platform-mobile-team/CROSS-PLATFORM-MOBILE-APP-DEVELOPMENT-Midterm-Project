# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
# Local backend databases, credentials and generated coverage.
backend/data/
backend/.env
backend/coverage/
backend/node_modules/
*.sqlite-wal
*.sqlite-shm
/.playwright-cli/
/output/playwright/
/test/golden/failures/

# Local study notes for presentation; never publish this file.
/TASKFLOW_GIAI_THICH_CODE_VA_THUYET_TRINH_LOCAL.md

# Personal notes and temporary work (not submission sources).
/local-notes/
/tmp/
/temp/
/.vscode/
__pycache__/
~$*.docx
~$*.xlsx
~$*.pptx

# Local secrets and backend database/backup files. Keep config examples.
.env
.env.*
!.env.example
/backend/backups/
/backend/**/*.sqlite
/backend/**/*.sqlite3

# Report rendering scratch files; retain final Word/PDF and LaTeX sources.
/output/qa/
/output/previews/
/docs/report/latex/*.aux
/docs/report/latex/*.toc
/docs/report/latex/*.lof
/docs/report/latex/*.lot
/docs/report/latex/*.out
/docs/report/latex/*.fls
/docs/report/latex/*.fdb_latexmk
/docs/report/latex/*.synctex.gz
/docs/report/latex/*.xdv
/docs/report/latex/*.pdf

# Do not ignore docs/evidence, test baselines, report assets or output/pdf:
# these are reviewed coursework evidence and final submission deliverables.
