# Run from backend/. Defaults bind only to this machine.
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=./data/taskflow.sqlite
# Exact origins only. Keep Flutter Web on this fixed port.
CORS_ORIGINS=http://localhost:7357,http://127.0.0.1:7357
# Bearer tokens require HTTPS before exposing the API beyond local development.
